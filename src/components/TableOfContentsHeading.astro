---
import type { Heading } from "./TableOfContents.astro";
import Link from "./Link.astro";

type Props = {
  heading: Heading;
  number: string;
};

const { heading, number } = Astro.props as Props;
const subheadings = heading.subheadings ?? [];
const isNested = number.includes(".");
---

<li class:list={["toc-item", isNested && "toc-item-sub"]}>
  <span
    class:list={["toc-number", isNested && "toc-number-sub"]}
    aria-hidden="true"
  >
    {number}
  </span>
  <Link href={`#${heading.slug}`} underline>
    {heading.text}
  </Link>
  {
    subheadings.length > 0 && (
      <ul class="toc-sublist">
        {subheadings.map((subheading, index) => (
          <Astro.self heading={subheading} number={`${number}.${index + 1}`} />
        ))}
      </ul>
    )
  }
</li>
