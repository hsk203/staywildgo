---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

export interface Heading {
  depth: number;
  slug: string;
  text: string;
  subheadings?: Heading[];
}

type FlatHeading = Pick<Heading, "depth" | "slug" | "text">;

const { headings } = Astro.props as { headings: FlatHeading[] };
const toc = buildToc(headings);

function buildToc(headings: FlatHeading[]): Heading[] {
  const toc: Heading[] = [];
  const parentHeadings = new Map<number, Heading>();

  for (const item of headings) {
    if (item.depth < 2) continue;

    const heading: Heading = { ...item, subheadings: [] };
    for (const depth of parentHeadings.keys()) {
      if (depth >= heading.depth) parentHeadings.delete(depth);
    }
    parentHeadings.set(heading.depth, heading);

    if (heading.depth === 2) {
      toc.push(heading);
      continue;
    }

    const parent = parentHeadings.get(heading.depth - 1);
    if (parent) parent.subheadings?.push(heading);
    else toc.push(heading);
  }

  return toc;
}
---

<details open class="toc-panel animate group">
  <summary
    class="cursor-pointer rounded-xl px-5 py-4 font-medium text-[var(--text)] transition-colors hover:bg-[var(--surface-muted)]"
    >Contents</summary
  >
  <nav aria-label="Table of contents">
    <ul class="toc-list">
      {
        toc.map((heading, index) => (
          <TableOfContentsHeading
            heading={heading}
            number={String(index + 1).padStart(2, "0")}
          />
        ))
      }
    </ul>
  </nav>
</details>
