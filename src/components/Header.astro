---
import ThemePicker from "@components/ThemePicker.astro";
import { Icon } from "astro-icon/components";
import { NAV_LINKS, SITE } from "@consts";

const { pathname } = Astro.url;
const items = NAV_LINKS;

const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 h-16">
  <div class="site-header-inner">
    <div class="site-nav-shell h-16">
      <div
        class="site-nav-content flex h-full items-center justify-between gap-5"
      >
        <a href="/" class="brand-link" aria-label={`${SITE.TITLE} home`}>
          <img
            src="/brand/staywildgo-horizontal.png"
            alt="StayWildGo"
            class="brand-logo brand-logo-light"
            width="180"
            height="43"
          />
          <img
            src="/brand/staywildgo-horizontal.png"
            alt=""
            aria-hidden="true"
            class="brand-logo brand-logo-dark"
            width="180"
            height="43"
          />
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
          {
            items.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "sphere-nav-link",
                  isActive(item.href) && "is-active",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-1 sm:gap-2">
          <a
            href="/rss.xml"
            class="sphere-icon-button hidden sm:inline-flex"
            aria-label="RSS feed"
            title="RSS feed"
          >
            <Icon name="tabler:rss" size={18} aria-hidden="true" />
          </a>
          <button
            type="button"
            class="sphere-icon-button"
            data-search-trigger
            aria-label="Open site search"
            aria-keyshortcuts="/ Control+K Meta+K"
            title="Search"
          >
            <Icon name="tabler:search" size={18} aria-hidden="true" />
          </button>
          <ThemePicker />

          <button
            id="menu-toggle"
            type="button"
            class="sphere-icon-button lg:hidden"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            title="Menu"
          >
            <span class="menu-icon menu-icon-open">
              <Icon name="tabler:menu-2" size={19} aria-hidden="true" />
            </span>
            <span class="menu-icon menu-icon-close">
              <Icon name="tabler:x" size={19} aria-hidden="true" />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true">
    <nav class="flex flex-col items-center gap-2" aria-label="Mobile navigation">
      <a
        href="/"
        data-menu-link
        aria-current={isActive("/") ? "page" : undefined}
        class:list={["sphere-nav-link", isActive("/") && "is-active"]}
      >
        Home
      </a>
      {
        items.map((item) => (
          <a
            href={item.href}
            data-menu-link
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={["sphere-nav-link", isActive(item.href) && "is-active"]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/about" data-menu-link class="sphere-nav-link">About</a>
      <a href="/contact" data-menu-link class="sphere-nav-link">Contact</a>
      <a href="/tags" data-menu-link class="sphere-nav-link">Tags</a>
      <a href="/rss.xml" data-menu-link class="sphere-nav-link">RSS</a>
    </nav>
  </div>
</header>

<script is:inline>
  function initializeMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.ready === "true") return;

    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation menu");
      toggle.setAttribute("title", "Menu");
      menu.setAttribute("aria-hidden", "true");
      menu.classList.remove("is-open");
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.setAttribute("aria-label", open ? "Open navigation menu" : "Close navigation menu");
      toggle.setAttribute("title", open ? "Menu" : "Close");
      menu.setAttribute("aria-hidden", String(open));
      menu.classList.toggle("is-open", !open);
    });

    menu.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    toggle.dataset.ready = "true";
  }

  initializeMobileMenu();
  document.addEventListener("astro:page-load", initializeMobileMenu);
</script>
