---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { CONTACT } from "@consts";
---

<Layout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <div class="page-shell">
    <Container>
      <Breadcrumbs items={[{ label: "Contact" }]} />
      <article class="article-shell animate">
        <header class="article-hero">
          <h1>Contact</h1>
          <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">
            The fastest way to reach us is email. We read everything and
            reply to what we can.
          </p>
        </header>

        <h2>Email</h2>
        <p>
          <a href="mailto:hello@staywildgo.com">hello@staywildgo.com</a>
        </p>

        <h2>What to write about</h2>
        <ul>
          <li>
            <strong>Corrections:</strong> a price, a regulation, or a fact in
            one of our guides that has changed — tell us the article and the
            right figure, and we will fix it.
          </li>
          <li>
            <strong>Route and lake tips:</strong> a ramp, a trail, or a
            launch spot we should check out.
          </li>
          <li>
            <strong>Gear questions:</strong> what to buy for a first setup,
            or how a product held up for you.
          </li>
          <li>
            <strong>Partnerships:</strong> gear loans for field testing and
            honest reviews — we do not publish paid reviews.
          </li>
        </ul>

        <h2>What not to expect</h2>
        <p>
          We are a small one-person site, not a shop or a booking service.
          We cannot sell you gear, book a campsite, or give real-time advice
          on conditions at a specific lake. For permits and current
          regulations, always check the official park or state agency page.
        </p>
      </article>
    </Container>
  </div>
</Layout>
