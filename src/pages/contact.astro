---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { CONTACT } from "@consts";
---

<Layout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <div class="page-shell">
    <Container>
      <Breadcrumbs items={[{ label: "Contact" }]} />
      <article class="article-shell animate">
        <header class="article-hero">
          <h1>Contact</h1>
          <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">
            The quickest way to reach me is by email. I read every message and
            reply when I can.
          </p>
        </header>

        <h2>Email</h2>
        <p>
          <a href="mailto:hello@staywildgo.com">hello@staywildgo.com</a>
        </p>

        <h2>Good reasons to write</h2>
        <ul>
          <li>
            <strong>Corrections:</strong> if a price, regulation, or fact has changed,
            include the article and the updated source or figure.
          </li>
          <li>
            <strong>Route and lake tips:</strong> a ramp, trail, launch spot, or campsite
            you think is worth checking out.
          </li>
          <li>
            <strong>Gear questions:</strong> what to choose for a first setup, or
            how a product has held up for you.
          </li>
          <li>
            <strong>Partnerships:</strong> gear loans for field testing and honest
            reviews are welcome. I do not publish paid reviews.
          </li>
        </ul>

        <h2>What I can't provide</h2>
        <p>
          StayWildGo is a one-person field notebook, not a shop or booking
          service. I cannot sell you gear, reserve a campsite, or report live
          conditions at a specific lake. For permits and current regulations,
          check the official park or state agency page.
        </p>
      </article>
    </Container>
  </div>
</Layout>
